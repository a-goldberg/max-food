{
  "name": "whoa-slow-go",
  "version": "1.1.4",
  "description": "A small browser-based educational food categorization game.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --legacy-watch --watch server.js --watch views --watch public --watch data --ignore node_modules server.js",
    "pm2:start": "PM2_HOME=.pm2 pm2 start ecosystem.config.js",
    "pm2:stop": "PM2_HOME=.pm2 pm2 stop whoa-slow-go",
    "pm2:restart": "PM2_HOME=.pm2 pm2 restart whoa-slow-go",
    "pm2:logs": "PM2_HOME=.pm2 pm2 logs whoa-slow-go"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "ejs": "^3.1.10",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pm2": "^7.0.1"
  }
}
