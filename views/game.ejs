<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-PXY7F9PRCX"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-PXY7F9PRCX");
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="<%= pageDescription %>" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="<%= pageTitle %>" />
    <meta property="og:description" content="<%= pageDescription %>" />
    <meta property="og:url" content="<%= pageUrl %>" />
    <meta property="og:image" content="<%= shareImageUrl %>" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta
      property="og:image:alt"
      content="A barbecue plate used as the Whoa Slow Go sharing image"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= pageTitle %>" />
    <meta name="twitter:description" content="<%= pageDescription %>" />
    <meta name="twitter:image" content="<%= shareImageUrl %>" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/game.css" />
    <script
      defer
      src="/vendor/canvas-confetti/confetti.browser.min.js"
    ></script>
    <script defer src="/js/game.js"></script>
  </head>
  <body>
    <p class="app-version">v. <%= versionNumber %></p>

    <main class="game-shell">
      <header class="game-header" aria-label="Game progress">
        <div class="brand-block">
          <p class="eyebrow">MAX PRESENTS:</p>
          <h1><%= pageTitle %></h1>
        </div>

        <section class="score-board" aria-label="Score board">
          <div class="score-pill">
            <span aria-hidden="true">★</span>
            <span>Score: <strong id="score">0</strong></span>
          </div>
          <div class="score-pill">
            <span aria-hidden="true">🔥</span>
            <span>Streak: <strong id="streak">0</strong></span>
          </div>
          <div class="score-pill">
            <span>Best: <strong id="best-score">0</strong></span>
          </div>
        </section>
      </header>

      <section class="game-card" aria-live="polite">
        <p class="round-count" id="round-count">Loading foods...</p>
        <h2 id="question">Which kind of food is this?</h2>

        <figure class="food-display">
          <img id="food-image" src="" alt="" />
          <figcaption id="food-name">Food name</figcaption>
        </figure>

        <p class="helper-text" id="helper-text">
          Think carefully, then choose!
        </p>

        <div class="answer-grid" id="answer-grid" aria-label="Answer choices">
          <button class="answer-button whoa" type="button" data-category="whoa">
            <span>Whoa</span>
            <small>once in a while</small>
          </button>
          <button class="answer-button slow" type="button" data-category="slow">
            <span>Slow</span>
            <small>sometimes</small>
          </button>
          <button class="answer-button go" type="button" data-category="go">
            <span>Go</span>
            <small>everyday</small>
          </button>
        </div>

        <section
          class="final-screen hidden"
          id="final-screen"
          aria-live="polite"
        >
          <h2>Nice sorting!</h2>
          <p id="final-score"></p>
          <p id="best-score-note"></p>
          <button class="next-button" id="play-again-button" type="button">
            Play Again
          </button>
        </section>
      </section>
    </main>

    <section
      class="feedback hidden"
      id="feedback"
      role="dialog"
      aria-modal="true"
      aria-live="assertive"
      aria-labelledby="feedback-title"
    >
      <div class="feedback-dialog">
        <h3 id="feedback-title"></h3>
        <p id="feedback-explanation"></p>
        <p class="celebration" id="celebration"></p>
        <button class="next-button" id="next-button" type="button">
          Next Food
        </button>
      </div>
    </section>
  </body>
</html>
