<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-PXY7F9PRCX"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-PXY7F9PRCX");
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="<%= pageDescription %>" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="<%= pageTitle %>" />
    <meta property="og:description" content="<%= pageDescription %>" />
    <meta property="og:url" content="<%= pageUrl %>" />
    <meta property="og:image" content="<%= shareImageUrl %>" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Grilled Liger meat used as the Whoa Slow Go sharing image"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= pageTitle %>" />
    <meta name="twitter:description" content="<%= pageDescription %>" />
    <meta name="twitter:image" content="<%= shareImageUrl %>" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/game.css" />
    <script defer src="/vendor/canvas-confetti/confetti.browser.js"></script>
    <script>
      window.WHOA_FOOD_CONFIG = <%- gameConfigJson %>;
    </script>
    <script defer src="/js/game.js"></script>
  </head>
  <body>
    <p class="app-version">v. <%= versionNumber %></p>

    <main class="game-shell">
      <header class="game-header" aria-label="Game progress">
        <div class="brand-block">
          <p class="eyebrow">MAX PRESENTS:</p>
          <h1>A Healthy Food Game</h1>
        </div>

        <section class="score-board" aria-label="Score board">
          <div class="score-pill">
            <span aria-hidden="true">★</span>
            <span>Score: <strong id="score">0</strong></span>
          </div>
          <div class="score-pill">
            <span aria-hidden="true">🔥</span>
            <span>Streak: <strong id="streak">0</strong></span>
          </div>
          <div class="score-pill">
            <span>Best: <strong id="best-streak">0</strong></span>
          </div>
          <div class="score-pill timer-pill hidden" id="timer-pill">
            <span>Time: <strong id="timer">--</strong></span>
          </div>
        </section>
      </header>

      <section class="game-card" aria-live="polite">
        <p class="round-count" id="round-count">Loading foods...</p>
        <h2 id="question">Is This a Healthy Food?</h2>

        <figure class="food-display">
          <img id="food-image" src="" alt="" />
          <figcaption id="food-name">Food name</figcaption>
        </figure>

        <p class="helper-text" id="helper-text">
          Think carefully, then choose!
        </p>

        <button
          class="quit-button hidden"
          id="quit-game-button"
          type="button"
        >
          Quit
        </button>

        <div class="answer-grid" id="answer-grid" aria-label="Answer choices">
          <button class="answer-button whoa" type="button" data-category="whoa">
            <span>Whoa</span>
            <small>once in a while</small>
          </button>
          <button class="answer-button slow" type="button" data-category="slow">
            <span>Slow</span>
            <small>sometimes</small>
          </button>
          <button class="answer-button go" type="button" data-category="go">
            <span>Go</span>
            <small>everyday</small>
          </button>
        </div>

        <section
          class="final-screen hidden"
          id="final-screen"
          aria-live="polite"
        >
          <h2>Nice sorting!</h2>
          <p id="final-score"></p>
          <p id="best-streak-note"></p>
          <p class="save-status" id="save-status"></p>

          <section class="leaderboard hidden" id="leaderboard">
            <h3>Leaderboard</h3>
            <ol id="leaderboard-list"></ol>
          </section>

          <button class="next-button" id="play-again-button" type="button">
            Play Again
          </button>
        </section>
      </section>
    </main>

    <section
      class="start-screen hidden"
      id="start-screen"
      role="dialog"
      aria-modal="true"
      aria-labelledby="start-title"
    >
      <form class="start-dialog" id="start-form">
        <p class="eyebrow">MAX PRESENTS:</p>
        <h2 id="start-title">A Healthy Food Game</h2>

        <label class="field-label" for="player-name">
          Name
          <input
            id="player-name"
            name="playerName"
            type="text"
            maxlength="<%= playerNameMaxLength %>"
            autocomplete="nickname"
            placeholder="Bingo"
            required
          />
        </label>

        <label class="field-label" for="player-location">
          Location
          <input
            id="player-location"
            name="playerLocation"
            type="text"
            maxlength="<%= playerLocationMaxLength %>"
            autocomplete="address-level2"
            placeholder="Ding Dong, TX"
          />
        </label>

        <fieldset class="difficulty-field">
          <legend>Difficulty</legend>
          <label title="No timer. Correct answers are worth 10 points.">
            <input type="radio" name="difficulty" value="practice" />
            <span>Practice</span>
          </label>
          <label
            title="6 second timer. Fast correct answers can score up to 12 points."
          >
            <input type="radio" name="difficulty" value="normal" checked />
            <span>Normal</span>
          </label>
          <label
            title="3 second timer. Fast correct answers can score up to 15 points."
          >
            <input type="radio" name="difficulty" value="hard" />
            <span>Hard</span>
          </label>
        </fieldset>

        <p class="update-note">
          New update! Your score is now calculated, in part, by how quickly you
          select the correct answer. Think fast! Then check your position on
          the leaderboard after you play.
        </p>

        <p class="form-error" id="start-error" aria-live="polite"></p>

        <div class="start-actions">
          <button class="next-button" type="submit">Start Game</button>
          <button
            class="secondary-button"
            id="start-leaderboard-button"
            type="button"
          >
            View Leaderboard
          </button>
        </div>

      </form>

      <section
        class="start-dialog start-leaderboard-panel hidden"
        id="start-leaderboard-panel"
        aria-labelledby="start-leaderboard-title"
      >
        <p class="eyebrow">MAX PRESENTS:</p>
        <h2 id="start-leaderboard-title">Leaderboard</h2>

        <section class="leaderboard start-leaderboard" id="start-leaderboard">
          <h3>Top Scores</h3>
          <ol id="start-leaderboard-list"></ol>
        </section>

        <p class="form-error" id="start-leaderboard-status" aria-live="polite"></p>

        <button
          class="secondary-button"
          id="back-to-start-button"
          type="button"
        >
          Back
        </button>
      </section>
    </section>

    <section
      class="feedback hidden"
      id="feedback"
      role="dialog"
      aria-modal="true"
      aria-live="assertive"
      aria-labelledby="feedback-title"
    >
      <div class="feedback-dialog">
        <h3 id="feedback-title"></h3>
        <p id="feedback-explanation"></p>
        <p class="celebration" id="celebration"></p>
        <button class="next-button" id="next-button" type="button">
          Next Food
        </button>
      </div>
    </section>
  </body>
</html>
